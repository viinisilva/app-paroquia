# Neon > Connect > connection string (pooled), usar verificação completa do certificado
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=verify-full
APP_URL=http://localhost:3000
# Opcional: permite executar Playwright contra um Preview remoto.
PLAYWRIGHT_BASE_URL=
# Somente para criar o primeiro ADMIN com pnpm db:seed. Sem valores padrão.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcional: dados fictícios de agenda, identificados como demonstração.
SEED_DEMO=false
